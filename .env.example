# Server-only configuration used by BOTH npm run dev and npm start.
# Store in the ignored .env or the server environment, never public/ or src/.
# Ethereum, Arbitrum, Base and BNB have public fallbacks; Robinhood needs an RPC.
# Use HTTPS for remote authenticated endpoints. Leave unused overrides blank.
RPC_ETHEREUM=
RPC_ARBITRUM=
RPC_BASE=
RPC_BNB=
RPC_ROBINHOOD=
