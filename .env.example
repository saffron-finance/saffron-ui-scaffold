# Server-only RPC configuration for npm start / npm run serve.
# Ethereum, Arbitrum, Base and BNB have public fallbacks. Robinhood needs an RPC.
# Keep authenticated URLs in this ignored .env file or the hosting environment.
RPC_ETHEREUM=
RPC_ARBITRUM=
RPC_BASE=
RPC_BNB=
RPC_ROBINHOOD=

# Optional LOCAL-development overrides. VITE_ values are visible to the local
# development browser. Do not use authenticated URLs in a shared dev server.
# Normal production builds use only same-origin /rpc/<chain> reads.
VITE_RPC_ETHEREUM=
VITE_RPC_ARBITRUM=
VITE_RPC_BASE=
VITE_RPC_BNB=
VITE_RPC_ROBINHOOD=
